
OPENAI_API_KEY=your-api-key-here
API_URL=https://api.deepseek.com/v1
MODEL=deepseek-v4-flash

# 自定义请求头（可选，用于中转站等需要特殊 UA 的场景）
# HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# HTTP_REFERER=https://example.com

EMBEDDING_KEY=your-embedding-key-here
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_URL=https://api.siliconflow.cn/v1
PAICLI_APPROVAL="off"

# Skill 自动选择（推荐开启）
PAICLI_AUTO_SKILLS=1

# 日志配置
SHADOWCLI_DEBUG_LOG=true              # 启用调试日志，保存到 logs/debug/debug.log（自动轮转，最大 10MB × 3 份）
SHADOWCLI_LOG_LEVEL=INFO              # 控制台日志级别: DEBUG/INFO/WARNING/ERROR
